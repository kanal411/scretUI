void setup() {
  Serial.begin(115200);
  delay(1000);
  Serial.println("Aktualizacja");

  pinMode(batteryOn, INPUT);
  analogReadResolution(ADC_RESOLUTION);
  analogSetAttenuation(ADC_11db);
  pinMode(BAT_ADC_PIN, INPUT);

  if (check != 0x12345678) {
    check = 0x12345678;
    for (int i = 0; i < 10; i++)
    {
      chmurkaLokalizacja[i] = {-1, -1};
    }
    godzinaSave = {-1, -1};
    iloscZlychCykli = 0;
    batteryPercentLast = 100;
  }

  SPI.begin(EPD_SCK, -1, EPD_MOSI, EPD_CS);

  NimBLEDevice::init("ESP32S3_BLE");

  NimBLEDevice::setPower(ESP_PWR_LVL_P9);
  NimBLEDevice::setSecurityAuth(false, false, false);

  pServer = NimBLEDevice::createServer();
  pServer->setCallbacks(new ServerCallbacks());

  pService = pServer->createService(SERVICE_UUID);

  pCharacteristic = pService->createCharacteristic(
    CHARACTERISTIC_UUID,
    NIMBLE_PROPERTY::READ |
    NIMBLE_PROPERTY::WRITE |
    NIMBLE_PROPERTY::NOTIFY
  );

  pCharacteristic->setCallbacks(new CharacteristicCallbacks());
  pCharacteristic->setValue("ESP32 gotowy");

  pService->start();

  pAdvertising = NimBLEDevice::getAdvertising();
  pAdvertising->addServiceUUID(SERVICE_UUID);
  NimBLEDevice::startAdvertising();
}

std::string timeToString(int hours, int minutes) {
    return std::format("{:02}:{:02}", hours, minutes);
}

void loop() {
  if (sleepPending && !deviceConnected && forecastReceived && delayReceived) {
    uint32_t start = millis();
    NimBLEDevice::deinit(true);
    if (dateReady && forecastReady && toDoReady)
    {
        std::array<pogodaStruct, 12> items;
        std::vector<std::string> toDoFinal;
        bool dobraPogoda = false;

        if (parseList12(receivedForecast, items))
        {
            for (int j = 0; j < 12; j++)
            {
                prognoza[j].temp = items[j].temp;
                prognoza[j].deszcz = items[j].deszcz;
                prognoza[j].zachmurzenie = items[j].zachmurzenie;
                prognoza[j].godzina = items[j].godzina;

                if (items[j].deszcz <= 1) prognoza[j].ikona = slonce;
                else if (items[j].deszcz >= 70) prognoza[j].ikona = deszcz;
                else prognoza[j].ikona = chmura;
            }

            iloscZlychCykli = 0;
            dobraPogoda = true;
        }
        else Serial.println("Walony");

        std::string godzinaString = receivedDate.substr(0, 5);

        int godzinaInt = std::stoi(godzinaString.substr(3, 2));

        int poprawka = godzinaInt % 5;
        if (poprawka != 0)
        {
          godzinaInt -= poprawka;

          char bufor[3];
          sprintf(bufor, "%02d", godzinaInt);
          godzinaString[3] = bufor[0];
          godzinaString[4] = bufor[1];
        }

        if (godzinaSave.first == std::stoi(godzinaString.substr(0, 2)))
        {
          if (godzinaSave.second >= godzinaInt) godzinaInt += 5;
        }

        if (parseStringList(receivedToDo, toDoFinal) && dobraPogoda) {
          refreshScreen(godzinaString, prognoza, receivedDate.substr(6, 10), true, toDoFinal);
        }
        else {
          Serial.println("Blad wywalenia sie");
        }
    }
    else
    {
      Serial.println("Wywalilem sie");
    }

    uint32_t spent = millis() - start;

    uint32_t correctedSleep = lastDelayMs;


    if (spent < correctedSleep) {
        correctedSleep -= spent;
        Serial.println("Poprawny sleep");
        Serial.print("spie na: ");
        Serial.println(formatTime(correctedSleep).c_str());
        Serial.print("spedzilem: ");
        Serial.println(formatTime(spent).c_str());
    } else {
        correctedSleep = 0;
        Serial.print("Spadlem z rowerka");
    }

    sleepPending = false;
    restartPending = false;
    goToDeepSleep(correctedSleep);
  }

  if (!deviceConnected && (millis() - advertisingStartTime > 2 * 60 * 1000UL)) {
    NimBLEDevice::deinit(true);
    int godzinaAwaryjna = godzinaSave.first;
    int minutaAwaryjna = godzinaSave.second;
    minutaAwaryjna += 5;
    if (minutaAwaryjna >= 60)
    {
      godzinaAwaryjna++;
      minutaAwaryjna = 0;
      if (godzinaAwaryjna >= 24)
      {
        godzinaAwaryjna == 0;
      }
    }

    pogodaStruct prognozaAwaryjna[12];

    if (iloscZlychCykli < 60)
    {
      for (int i = 0; i < 7; i++)
      {
        prognozaAwaryjna[i] = prognozaLocalSave[iloscZlychCykli + i];
      }
    }

    refreshScreen(timeToString(godzinaAwaryjna, minutaAwaryjna), prognozaAwaryjna, dataEkranSave, false);
    
    iloscZlychCykli++;
    goToDeepSleep(180 * 1000UL);
  }

  delay(10);
}
