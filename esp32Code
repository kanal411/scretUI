namespace sun_detail {

constexpr double TO_RAD = PI / 180.0;
constexpr double TO_DEG = 180.0 / PI;

inline double wrapDeg(double x) {
    return x - 360.0 * std::floor(x / 360.0);
}

inline double julianDay(int d, int m, int y, double utcH) {
    if (m <= 2) { --y; m += 12; }
    int A = y / 100;
    int B = 2 - A + A / 4;
    return std::floor(365.25  * (y + 4716.0))
         + std::floor(30.6001 * (m +    1.0))
         + d + B - 1524.5
         + utcH / 24.0;
}

inline void solarParams(double JD, double &eqTime, double &declDeg) {
    const double T  = (JD - 2451545.0) / 36525.0;

    const double L0 = wrapDeg(280.46646 + T * (36000.76983 + T * 0.0003032));
    const double M  = wrapDeg(357.52911 + T * (35999.05029 - T * 0.0001537));
    const double e  = 0.016708634 - T * (0.000042037 + T * 0.0000001267);

    const double Mrad = M * TO_RAD;
    const double C = (1.914602 - T * (0.004817 + T * 0.000014)) * std::sin(Mrad)
                   + (0.019993 - T * 0.000101)                   * std::sin(2.0 * Mrad)
                   + 0.000289                                    * std::sin(3.0 * Mrad);

    const double omega  = 125.04 - 1934.136 * T;
    const double lambda = (L0 + C) - 0.00569 - 0.00478 * std::sin(omega * TO_RAD);

    const double eps0 = 23.0
        + (26.0 + (21.448 - T * (46.815 + T * (0.00059 - T * 0.001813))) / 60.0) / 60.0;
    const double epsRad = (eps0 + 0.00256 * std::cos(omega * TO_RAD)) * TO_RAD;

    declDeg = std::asin(std::sin(epsRad) * std::sin(lambda * TO_RAD)) * TO_DEG;

    double y2 = std::tan(epsRad * 0.5);
    y2 *= y2;

    eqTime = 4.0 * TO_DEG * (
          y2         * std::sin(2.0 * L0 * TO_RAD)
        - 2.0 * e    * std::sin(Mrad)
        + 4.0 * e*y2 * std::sin(Mrad) * std::cos(2.0 * L0 * TO_RAD)
        - 0.5 * y2*y2 * std::sin(4.0 * L0 * TO_RAD)
        - 1.25 * e*e * std::sin(2.0 * Mrad)
    );
}

inline double sunriseAngle(double latDeg, double declDeg,
                           bool &polarDay, bool &polarNight) {
    const double cosHA =
        (std::sin(-0.833 * TO_RAD)
       - std::sin(latDeg  * TO_RAD) * std::sin(declDeg * TO_RAD))
       / (std::cos(latDeg  * TO_RAD) * std::cos(declDeg * TO_RAD));

    polarDay   = (cosHA < -1.0);
    polarNight = (cosHA >  1.0);

    if (polarDay || polarNight) return 0.0;
    return std::acos(cosHA) * TO_DEG;
}

}

inline float sunProgress(const std::string &dateStr, const std::string &timeStr) {
    using namespace sun_detail;

    const int day   = std::atoi(dateStr.substr(0, 2).c_str());
    const int month = std::atoi(dateStr.substr(3, 2).c_str());
    const int year  = std::atoi(dateStr.substr(6, 4).c_str());

    const int hh = std::atoi(timeStr.substr(0, 2).c_str());
    const int mm = std::atoi(timeStr.substr(3, 2).c_str());
    double utcMin = hh * 60.0 + mm - SUN_UTC_OFFSET_H * 60.0;

    int d = day;
    if (utcMin < 0.0)    { utcMin += 1440.0; --d; }
    if (utcMin >= 1440.0){ utcMin -= 1440.0; ++d; }

    const double JD = julianDay(d, month, year, utcMin / 60.0);

    double eqTime, declDeg;
    solarParams(JD, eqTime, declDeg);

    bool polarDay, polarNight;
    const double HA = sunriseAngle(SUN_LAT_DEG, declDeg, polarDay, polarNight);
    if (polarNight) return -1.0f;
    if (polarDay)   return  0.5f;

    const double solarNoon = 720.0 - 4.0 * SUN_LON_DEG - eqTime;
    const double sunrise   = solarNoon - HA * 4.0;
    const double sunset    = solarNoon + HA * 4.0;

    if (utcMin <= sunrise || utcMin >= sunset)
        return -1.0f;

    return static_cast<float>((utcMin - sunrise) / (sunset - sunrise));
}

std::pair<int, int> sunPosition(float procentUkonczenia)
{
  int x = (procentUkonczenia * 230) + 0.5f;

  int d = x - 115;
  int y = (-0.0076f * d * d + 100) + 0.5f;

  return {x, y};
}

std::string formatTime(uint32_t ms)
{
    uint32_t totalSeconds = ms / 1000;
    uint32_t minutes = totalSeconds / 60;
    uint32_t seconds = totalSeconds % 60;

    return std::format("{}:{:02}", minutes, seconds);
}

static constexpr int   BAT_ADC_PIN     = A1;
static constexpr float R1_OHM          = 100000.0f;
static constexpr float R2_OHM          = 220000.0f;
static constexpr float DIVIDER_RATIO   = (R1_OHM + R2_OHM) / R2_OHM;
static constexpr int   ADC_RESOLUTION  = 12;
static constexpr int   ADC_MAX_VALUE   = (1 << ADC_RESOLUTION) - 1;
static constexpr float VREF            = 3.3f;
static constexpr int   NUM_SAMPLES     = 64;
static constexpr int   DISCARD_OUTLIERS = 8;

static constexpr float ADC_CORRECTION_OFFSET = 0.0f;
static constexpr float ADC_CORRECTION_GAIN   = 1.0f;

static void sortArray(int* arr, int len) {
    for (int i = 0; i < len - 1; i++) {
        for (int j = 0; j < len - i - 1; j++) {
            if (arr[j] > arr[j + 1]) {
                int tmp = arr[j];
                arr[j] = arr[j + 1];
                arr[j + 1] = tmp;
            }
        }
    }
}

static float readAdcVoltage(int pin) {
#if defined(ESP_ARDUINO_VERSION_MAJOR) && ESP_ARDUINO_VERSION_MAJOR >= 2
    int samples[NUM_SAMPLES];
    for (int i = 0; i < NUM_SAMPLES; i++) {
        samples[i] = analogReadMilliVolts(pin);
        delayMicroseconds(100);
    }
    sortArray(samples, NUM_SAMPLES);

    long sum = 0;
    int  count = NUM_SAMPLES - DISCARD_OUTLIERS;
    int  start = DISCARD_OUTLIERS / 2;
    for (int i = start; i < start + count; i++) {
        sum += samples[i];
    }
    float avgMillivolts = static_cast<float>(sum) / static_cast<float>(count);
    float adcVoltage = avgMillivolts / 1000.0f;
#else
    int samples[NUM_SAMPLES];
    for (int i = 0; i < NUM_SAMPLES; i++) {
        samples[i] = analogRead(pin);
        delayMicroseconds(100);
    }
    sortArray(samples, NUM_SAMPLES);

    long sum = 0;
    int  count = NUM_SAMPLES - DISCARD_OUTLIERS;
    int  start = DISCARD_OUTLIERS / 2;
    for (int i = start; i < start + count; i++) {
        sum += samples[i];
    }
    float avg = static_cast<float>(sum) / static_cast<float>(count);
    float adcVoltage = (avg / ADC_MAX_VALUE) * VREF;
#endif

    adcVoltage = adcVoltage * ADC_CORRECTION_GAIN + ADC_CORRECTION_OFFSET;
    return adcVoltage;
}

float readBatteryVoltage() {
    float adcVoltage = readAdcVoltage(BAT_ADC_PIN);
    float batteryVoltage = adcVoltage * DIVIDER_RATIO;
    return batteryVoltage;
}

float batteryPercent(float voltage) {
    static constexpr float V_MIN = 3.0f;
    static constexpr float V_MAX = 4.2f;
    float pct = (voltage - V_MIN) / (V_MAX - V_MIN) * 100.0f;
    if (pct < 0.0f)   pct = 0.0f;
    if (pct > 100.0f) pct = 100.0f;
    return pct;
}

std::string godzinaBackup(std::string baza, int przesuniecie)
{
  int godzinaLoc = stoi(baza.substr(0, 2));
  char buf[3];
  sprintf(buf, "%02d", (godzinaLoc + przesuniecie));
  std::string wynik = buf;
  wynik += ":00";
  return wynik;
}

