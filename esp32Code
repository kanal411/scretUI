static void skipSpaces(const std::string& input, std::size_t& i) {
    while (i < input.size() && std::isspace(static_cast<unsigned char>(input[i]))) {
        ++i;
    }
}

static void trim(std::string& s) {
    while (!s.empty() && std::isspace(static_cast<unsigned char>(s.front()))) {
        s.erase(s.begin());
    }
    while (!s.empty() && std::isspace(static_cast<unsigned char>(s.back()))) {
        s.pop_back();
    }
}

static bool readUntil(const std::string& input, std::size_t& i, char endChar, std::string& out) {
    std::size_t start = i;
    while (i < input.size() && input[i] != endChar) {
        ++i;
    }
    if (i >= input.size()) {
        return false;
    }
    out = input.substr(start, i - start);
    trim(out);
    return true;
}

static bool parseList12(const std::string& input, std::array<pogodaStruct, 12>& result) {
    std::size_t index = 0;
    std::size_t i = 0;

    auto trim = [](std::string& s) {
        std::size_t start = 0;
        std::size_t end = s.size();

        while (start < end && std::isspace(static_cast<unsigned char>(s[start]))) {
            ++start;
        }
        while (end > start && std::isspace(static_cast<unsigned char>(s[end - 1]))) {
            --end;
        }

        s = s.substr(start, end - start);

        if (s.size() >= 2 &&
            ((s.front() == '"' && s.back() == '"') ||
             (s.front() == '\'' && s.back() == '\''))) {
            s = s.substr(1, s.size() - 2);
        }
    };

    skipSpaces(input, i);
    if (i >= input.size() || input[i] != '[') {
        return false;
    }
    ++i;

    while (true) {
        skipSpaces(input, i);

        if (i < input.size() && input[i] == ']') {
            ++i;
            break;
        }

        if (index >= 12) {
            return false;
        }

        if (i >= input.size() || input[i] != '[') {
            return false;
        }
        ++i;

        skipSpaces(input, i);

        std::string godzina;
        if (!readUntil(input, i, ',', godzina)) return false;
        ++i;

        skipSpaces(input, i);
        std::string tempStr;
        if (!readUntil(input, i, ',', tempStr)) return false;
        ++i;

        skipSpaces(input, i);
        std::string deszczStr;
        if (!readUntil(input, i, ',', deszczStr)) return false;
        ++i;

        skipSpaces(input, i);
        std::string zachmurzenieStr;
        if (!readUntil(input, i, ']', zachmurzenieStr)) return false;
        ++i;

        trim(godzina);
        trim(tempStr);
        trim(deszczStr);
        trim(zachmurzenieStr);

        result[index].ikona = nullptr; // ustawisz później, jeśli chcesz
        result[index].godzina = godzina;
        result[index].temp = std::atoi(tempStr.c_str());
        result[index].deszcz = std::atoi(deszczStr.c_str());
        result[index].zachmurzenie = std::atoi(zachmurzenieStr.c_str());

        ++index;

        skipSpaces(input, i);
        if (i < input.size() && input[i] == ',') {
            ++i;
            continue;
        }

        if (i < input.size() && input[i] == ']') {
            ++i;
            break;
        }

        return false;
    }

    return index == 12;
}

static bool parseQuotedString(const std::string& s, std::size_t& i, std::string& out) {
    skipSpaces(s, i);
    if (i >= s.size() || s[i] != '"') return false;

    ++i;
    out.clear();

    while (i < s.size()) {
        char c = s[i++];

        if (c == '"') {
            return true;
        }

        if (c == '\\') {
            if (i >= s.size()) return false;
            char esc = s[i++];
            switch (esc) {
                case '"':  out.push_back('"');  break;
                case '\\': out.push_back('\\'); break;
                case 'n':  out.push_back('\n'); break;
                case 't':  out.push_back('\t'); break;
                case 'r':  out.push_back('\r'); break;
                default:   out.push_back(esc);  break;
            }
        } else {
            out.push_back(c);
        }
    }

    return false;
}

static bool parseStringList(const std::string& input, std::vector<std::string>& result) {
    result.clear();
    std::size_t i = 0;

    skipSpaces(input, i);
    if (i >= input.size() || input[i] != '[') return false;
    ++i;

    skipSpaces(input, i);
    if (i < input.size() && input[i] == ']') {
        ++i;
        return true;
    }

    while (true) {
        std::string value;
        if (!parseQuotedString(input, i, value)) return false;
        result.push_back(value);

        skipSpaces(input, i);
        if (i >= input.size()) return false;

        if (input[i] == ',') {
            ++i;
            continue;
        }

        if (input[i] == ']') {
            ++i;
            break;
        }

        return false;
    }

    skipSpaces(input, i);
    return i == input.size();
}

