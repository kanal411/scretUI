static uint16_t activeConnHandle = 0xFFFF;

class ServerCallbacks : public NimBLEServerCallbacks {
  void onConnect(NimBLEServer* pServer, NimBLEConnInfo& connInfo) override {
    if (activeConnHandle != 0xFFFF) {
      pServer->disconnect(connInfo.getConnHandle());
      return;
    }
    activeConnHandle = connInfo.getConnHandle();
    deviceConnected = true;

    rxBuffer.clear();
    receivedForecast.clear();
    receivedDate.clear();
    receivedToDo.clear();
    forecastReceived = false;
    dateReceived = false;
    toDoReceived = false;
    delayReceived = false;
    sleepPending = false;
    lastDelayMs = 0;
  }

  void onDisconnect(NimBLEServer* pServer, NimBLEConnInfo& connInfo, int reason) override {
    if (connInfo.getConnHandle() != activeConnHandle) {
      return;
    }
    activeConnHandle = 0xFFFF;
    deviceConnected = false;
    restartPending = true;
    sleepPending = true;
  }
};

class CharacteristicCallbacks : public NimBLECharacteristicCallbacks {
  void onWrite(NimBLECharacteristic* pCharacteristic, NimBLEConnInfo& connInfo) override {
    std::string value = pCharacteristic->getValue();
    rxBuffer += value;

    if (pierwszyPrzebieg) {Serial.println("Połączono"); pierwszyPrzebieg = false;}

    while (true) {
      size_t pos = rxBuffer.find('\n');
      if (pos == std::string::npos) {
        break;
      }

      std::string message = rxBuffer.substr(0, pos);
      rxBuffer.erase(0, pos + 1);

      if (!forecastReceived) {
        receivedForecast = message;
        forecastReceived = true;
        forecastReady = true;
        continue;
      }

      if (!dateReceived) {
        receivedDate = message;
        dateReceived = true;
        dateReady = true;
        continue;
      }

      if (!toDoReceived) {
        receivedToDo = message;
        toDoReceived = true;
        toDoReady = true;
        continue;
      }

      if (!delayReceived) {
        long receivedMs = atol(message.c_str());
        if (receivedMs < 0) receivedMs = 0;

        long waitMs = receivedMs + 100;
        if (waitMs < 0) waitMs = 0;

        lastDelayMs = (uint32_t)waitMs;
        delayReceived = true;
        Serial.print("Otrzymalem: ");
        Serial.println(formatTime(lastDelayMs).c_str());

        sleepPending = true;
      }
    }
  }
};

